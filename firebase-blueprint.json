{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "isSetupComplete": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Account": {
      "title": "Account",
      "description": "Financial accounts like cash, bank, bKash, Nagad",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "provider": { "type": "string", "maxLength": 128 },
        "accountNumber": { "type": "string", "maxLength": 64 },
        "openingBalance": { "type": "number" },
        "openingBalanceDate": { "type": "string", "maxLength": 64 },
        "currentBalance": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "type", "openingBalance", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "amount": { "type": "number" },
        "accountId": { "type": "string", "maxLength": 128 },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "personId": { "type": "string", "maxLength": 128 },
        "occurredAt": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 500 },
        "note": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 32 },
        "revisionNumber": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "type", "amount", "accountId", "occurredAt"]
    }
  },
  "firestore": {
    "/users/{userId}/profile": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "Financial accounts"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Transactions"
    }
  }
}
